# ─────────────────────────────────────────────────────────
# Self-Healing Data Pipeline Agent — Environment Variables
# ─────────────────────────────────────────────────────────

# Supabase Configuration (Optional - falls back to in-memory storage)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI & Agent Configuration
VITE_AI_MODEL_NAME=gemini-3.6-flash
VITE_REACT_FLOW_THEME=dark

# Ollama LLM Configuration (Optional - Diagnosis Agent falls back to deterministic mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Slack Webhook Configuration (Optional - notifications log to console if not set)
SLACK_WEBHOOK_OPS_ALERTS=https://hooks.slack.com/services/T00000000/B00000000/ops-alerts-channel
SLACK_WEBHOOK_ONCALL_PAGER=https://hooks.slack.com/services/T00000000/B00000000/oncall-pager-channel

# Python FastAPI Backend
PYTHON_API_HOST=127.0.0.1
PYTHON_API_PORT=8000

# Demo / Mock Engine Fallback (Enabled when Supabase keys are missing)
VITE_ENABLE_MOCK_FALLBACK=true

